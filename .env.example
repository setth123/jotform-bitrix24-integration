# Port the app listens on
PORT=3000

# Jotform API key (Jotform > Settings > API > Create New Key)
JOTFORM_API_KEY=your_jotform_api_key
# Use https://eu-api.jotform.com for EU accounts, https://hipaa-api.jotform.com for HIPAA
JOTFORM_API_URL=https://api.jotform.com

# Bitrix24 inbound webhook URL (must end with a slash), scope: crm
BITRIX24_WEBHOOK_URL=https://your-domain.bitrix24.com/rest/1/your_webhook_code/

# Log rotation (optional): rotate app.log at this size (MB), keep this many old files
LOG_MAX_SIZE_MB=5
LOG_MAX_FILES=5
